rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function deletedProfile() {
      return signedIn()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function staff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["teacher", "owner"];
    }
    function owner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }
    function activeStudent() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(profile)
        && get(profile).data.role == "student"
        && (!get(profile).data.keys().hasAny(["accountStatus"])
          || get(profile).data.accountStatus == "active");
    }
    match /settings/{settingId} {
      function validCategory(category, ordinal) {
        return category is map
          && category.keys().hasAll(["ordinal", "code", "name", "description", "legacyCodes"])
          && category.keys().hasOnly(["ordinal", "code", "name", "description", "legacyCodes"])
          && category.ordinal == ordinal
          && category.code is string
          && category.code.size() > 0
          && category.code.size() <= 32
          && category.legacyCodes is list
          && category.legacyCodes.size() <= 32
          && category.name is string
          && category.name.size() > 0
          && category.name.size() <= 100
          && category.description is string
          && category.description.size() > 0
          && category.description.size() <= 1600;
      }
      function validCategorySettings() {
        return request.resource.data.keys().hasAll(["categories", "updatedAt", "updatedBy"])
          && request.resource.data.keys().hasOnly(["categories", "updatedAt", "updatedBy"])
          && request.resource.data.categories is list
          && request.resource.data.categories.size() == 7
          && validCategory(request.resource.data.categories[0], 1)
          && validCategory(request.resource.data.categories[1], 2)
          && validCategory(request.resource.data.categories[2], 3)
          && validCategory(request.resource.data.categories[3], 4)
          && validCategory(request.resource.data.categories[4], 5)
          && validCategory(request.resource.data.categories[5], 6)
          && validCategory(request.resource.data.categories[6], 7)
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
          && request.resource.data.updatedBy == request.auth.uid;
      }
      allow read: if signedIn() && settingId == "errorCategories";
      allow create, update: if signedIn() && staff() && settingId == "errorCategories" && validCategorySettings();
      allow delete: if false;
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || staff());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == "student"
        && request.resource.data.keys().hasOnly(["displayName", "email", "role", "createdAt"])
        && request.resource.data.email == request.auth.token.email;
      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && (!resource.data.keys().hasAny(["accountStatus"]) || resource.data.accountStatus == "active")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "email"])
          && request.resource.data.email == request.auth.token.email
        ) || (
          owner()
          && resource.data.role == "student"
          && request.resource.data.role == "teacher"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
        ) || (
          staff()
          && resource.data.role == "student"
          && request.resource.data.role == "student"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accountStatus"])
          && request.resource.data.accountStatus in ["active", "disabled"]
        );
    }
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (
        (staff() && resource.data.teacherId == request.auth.uid)
        || (activeStudent() && request.auth.uid in resource.data.studentIds)
        || (deletedProfile() && (
          resource.data.teacherId == request.auth.uid
          || request.auth.uid in resource.data.studentIds
        ))
      );
      allow create: if staff()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentIds is list
        && request.resource.data.studentIds.size() > 0
        && request.resource.data.keys().hasAll([
          "id", "teacherId", "studentIds", "title", "questions", "students",
          "due", "state", "sections", "exam", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "id", "teacherId", "studentIds", "title", "questions", "students",
          "due", "state", "sections", "exam", "createdAt"
        ]);
      allow update: if staff()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentIds is list
        && request.resource.data.studentIds.size() > 0
        && request.resource.data.keys().hasAll([
          "id", "teacherId", "studentIds", "title", "questions", "students",
          "due", "state", "sections", "exam", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "id", "teacherId", "studentIds", "title", "questions", "students",
          "due", "state", "sections", "exam", "createdAt"
        ]) || (
          deletedProfile()
          && request.auth.uid in resource.data.studentIds
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentIds", "students"])
          && request.resource.data.studentIds is list
          && request.resource.data.studentIds.toSet()
            == resource.data.studentIds.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.students == request.resource.data.studentIds.size()
        );
      allow delete: if (staff() || deletedProfile()) && resource.data.teacherId == request.auth.uid;

      match /questions/{questionId} {
        function assignment() {
          return get(/databases/$(database)/documents/assignments/$(assignmentId));
        }
        allow read: if signedIn() && exists(/databases/$(database)/documents/assignments/$(assignmentId)) && (
          (staff() && assignment().data.teacherId == request.auth.uid)
          || (activeStudent() && request.auth.uid in assignment().data.studentIds)
          || (deletedProfile() && assignment().data.teacherId == request.auth.uid)
        );
        allow create: if staff() && request.resource.data.teacherId == request.auth.uid;
        allow update: if staff() && exists(/databases/$(database)/documents/assignments/$(assignmentId))
          && assignment().data.teacherId == request.auth.uid
          && request.resource.data.teacherId == request.auth.uid;
        allow delete: if (staff() || deletedProfile())
          && exists(/databases/$(database)/documents/assignments/$(assignmentId))
          && assignment().data.teacherId == request.auth.uid;
      }
    }
    match /attempts/{attemptId} {
      allow read: if signedIn() && (staff()
        || ((activeStudent() || deletedProfile()) && resource.data.userId == request.auth.uid));
      allow create: if signedIn()
        && activeStudent()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == attemptId
        && request.resource.data.keys().hasAll([
          "id", "userId", "title", "source", "score", "correct", "total",
          "graded", "duration", "createdAt", "reviewQuestionCount", "mistakes", "questionTimes"
        ])
        && request.resource.data.keys().hasOnly([
          "id", "userId", "title", "source", "score", "correct", "total",
          "graded", "duration", "createdAt", "reviewQuestionCount", "mistakes", "questionTimes"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && request.resource.data.source in ["personal", "teacher"]
        && (request.resource.data.score == null
          || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10))
        && request.resource.data.correct is int
        && request.resource.data.total is int
        && request.resource.data.graded is int
        && request.resource.data.duration is int
        && request.resource.data.reviewQuestionCount is int
        && request.resource.data.reviewQuestionCount >= 0
        && request.resource.data.reviewQuestionCount <= request.resource.data.total
        && request.resource.data.correct >= 0
        && request.resource.data.graded >= request.resource.data.correct
        && request.resource.data.total >= request.resource.data.graded
        && request.resource.data.duration >= 0
        && request.resource.data.createdAt is string
        && request.resource.data.mistakes is list
        && request.resource.data.mistakes.size() == 7
        && request.resource.data.questionTimes is map;
      allow update: if activeStudent()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
      allow delete: if deletedProfile() && resource.data.userId == request.auth.uid;

      match /questions/{reviewQuestionId} {
        function parentAttempt() {
          return get(/databases/$(database)/documents/attempts/$(attemptId));
        }
        function parentAttemptAfter() {
          return getAfter(/databases/$(database)/documents/attempts/$(attemptId));
        }
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/attempts/$(attemptId))
          && (staff() || ((activeStudent() || deletedProfile())
            && parentAttempt().data.userId == request.auth.uid));
        allow create: if activeStudent()
          && existsAfter(/databases/$(database)/documents/attempts/$(attemptId))
          && parentAttemptAfter().data.userId == request.auth.uid
          && request.resource.data.keys().hasAll([
            "id", "userId", "ordinal", "questionId", "questionNumber", "section",
            "errorIndex", "errorName", "content", "html", "sourceImageOnly", "choices",
            "answerKey", "userAnswer", "isCorrect", "questionTime"
          ])
          && request.resource.data.keys().hasOnly([
            "id", "userId", "ordinal", "questionId", "questionNumber", "section",
            "errorIndex", "errorName", "content", "html", "sourceImageOnly", "choices",
            "answerKey", "userAnswer", "isCorrect", "questionTime"
          ])
          && request.resource.data.id == reviewQuestionId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.ordinal is int
          && request.resource.data.ordinal > 0
          && request.resource.data.ordinal <= parentAttemptAfter().data.reviewQuestionCount
          && request.resource.data.questionId is string
          && request.resource.data.questionId.size() <= 160
          && request.resource.data.questionNumber is string
          && request.resource.data.questionNumber.size() <= 80
          && request.resource.data.section is string
          && request.resource.data.section.size() <= 80
          && request.resource.data.errorIndex is int
          && request.resource.data.errorIndex >= -1
          && request.resource.data.errorIndex < 7
          && request.resource.data.errorName is string
          && request.resource.data.errorName.size() <= 160
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 50000
          && request.resource.data.html is string
          && request.resource.data.html.size() <= 980000
          && request.resource.data.sourceImageOnly is bool
          && request.resource.data.choices is list
          && request.resource.data.choices.size() <= 8
          && (request.resource.data.answerKey == null || request.resource.data.answerKey is string)
          && (request.resource.data.userAnswer == null
            || request.resource.data.userAnswer is string
            || request.resource.data.userAnswer is map
            || request.resource.data.userAnswer is list
            || request.resource.data.userAnswer is number
            || request.resource.data.userAnswer is bool)
          && (request.resource.data.isCorrect == null || request.resource.data.isCorrect is bool)
          && request.resource.data.questionTime is int
          && request.resource.data.questionTime >= 0;
        allow update: if false;
        allow delete: if deletedProfile()
          && exists(/databases/$(database)/documents/attempts/$(attemptId))
          && parentAttempt().data.userId == request.auth.uid;
      }
    }
    match /questionSets/{setId} {
      allow read: if signedIn() && (
        staff()
        || (activeStudent() && resource.data.status == "published" && resource.data.hiddenFromStudents == false)
        || (deletedProfile() && resource.data.teacherId == request.auth.uid)
      );
      allow create: if staff()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == "uploading"
        && request.resource.data.keys().hasAll([
          "id", "title", "filename", "type", "questionCount", "sections",
          "teacherId", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "id", "title", "filename", "type", "questionCount", "sections",
          "teacherId", "status", "createdAt", "sourcePath", "sourceContentType", "hiddenFromStudents"
        ]);
      allow update: if staff() && (
        (resource.data.teacherId == request.auth.uid
          && resource.data.status == "uploading"
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && request.resource.data.status == "published")
        || (resource.data.status == "published"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFromStudents"])
          && request.resource.data.hiddenFromStudents is bool)
        || (resource.data.status == "published"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["questionCount", "sections"])
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount >= 0
          && request.resource.data.sections is list
          && request.resource.data.sections.size() <= 3)
      );
      allow delete: if staff() || (deletedProfile() && resource.data.teacherId == request.auth.uid);

      match /questions/{questionId} {
        function questionSet() {
          return get(/databases/$(database)/documents/questionSets/$(setId));
        }
        allow read: if signedIn() && exists(/databases/$(database)/documents/questionSets/$(setId)) && (
          staff()
          || (activeStudent() && questionSet().data.status == "published" && questionSet().data.hiddenFromStudents == false)
          || (deletedProfile() && questionSet().data.teacherId == request.auth.uid)
        );
        allow create: if staff()
          && exists(/databases/$(database)/documents/questionSets/$(setId))
          && questionSet().data.teacherId == request.auth.uid
          && questionSet().data.status == "uploading";
        allow update: if staff()
          && exists(/databases/$(database)/documents/questionSets/$(setId))
          && questionSet().data.status == "published";
        allow delete: if exists(/databases/$(database)/documents/questionSets/$(setId))
          && (staff() || (deletedProfile() && questionSet().data.teacherId == request.auth.uid));
      }
      match /sourcePages/{pageId} {
        function questionSet() {
          return get(/databases/$(database)/documents/questionSets/$(setId));
        }
        allow read: if (staff() || (deletedProfile()
          && exists(/databases/$(database)/documents/questionSets/$(setId))
          && questionSet().data.teacherId == request.auth.uid));
        allow create: if staff()
          && exists(/databases/$(database)/documents/questionSets/$(setId))
          && questionSet().data.teacherId == request.auth.uid
          && questionSet().data.status == "uploading"
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.page is int
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 1000000;
        allow update: if false;
        allow delete: if exists(/databases/$(database)/documents/questionSets/$(setId))
          && (staff() || (deletedProfile() && questionSet().data.teacherId == request.auth.uid));
      }
    }
    match /errorDocs/{errorDocId} {
      allow read: if (staff() || deletedProfile()) && resource.data.teacherId == request.auth.uid;
      function validErrorDoc() {
        return request.resource.data.keys().hasAll(["id", "teacherId", "name", "summary", "text", "createdAt"])
          && request.resource.data.keys().hasOnly(["id", "teacherId", "name", "summary", "text", "createdAt"])
          && request.resource.data.id == errorDocId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 1000
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 40000
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40;
      }
      allow create: if staff() && validErrorDoc();
      allow update: if staff() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId && validErrorDoc();
      allow delete: if (staff() || deletedProfile()) && resource.data.teacherId == request.auth.uid;
    }
  }
}
