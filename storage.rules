rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function staff() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ["teacher", "owner"];
    }
    match /question-set-assets/{teacherId}/{setId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if staff()
        && request.auth.uid == teacherId
        && (
          (request.resource.contentType.matches("image/(png|jpeg|gif|webp)")
            && request.resource.size < 8 * 1024 * 1024)
          || (request.resource.contentType in [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/pdf",
            "text/plain"
          ] && request.resource.size <= 15 * 1024 * 1024)
        );
      allow delete: if staff();
    }
  }
}
